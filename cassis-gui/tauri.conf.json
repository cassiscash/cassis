{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "cassis-gui",
  "version": "0.1.0",
  "identifier": "dev.cassis.gui",
  "build": {
    "frontendDist": "./web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cassis GUI",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
